# --- Hugging Face / torch caches (if created in-repo) ---
.cache/
**/huggingface/
**/transformers_cache/

# --- Large / regenerable ML weights (do not push to GitHub) ---
# Fine-tuned muRIL (~900MB+). Rebuild via scripts/run_music_rec.py sentiment
# or download from your own release / Kaggle export.
music_rec_artifacts/sentiment_model/

# Window-level embedding artifacts (~200MB; regenerate via scripts/kaggle_embeddings.py)
music_rec_artifacts/window_vectors.npy
music_rec_artifacts/window_owners.npy

# ONNX query encoder (~1.1GB; regenerate via scripts/export_embedding_onnx.py)
music_rec_artifacts/embedding_onnx/

# Regenerable probe candidate (canonical copy is sentiment_scores.csv)
music_rec_artifacts/sentiment_scores_probe.csv

# Training logs
music_rec_artifacts/*.log
*.log

# Optional: ignore binary matrices if you prefer a code-only repo
# (uncomment if you want demos to rebuild embeddings/index locally)
# music_rec_artifacts/*.npy
# music_rec_artifacts/*.faiss

# --- Archived experiments: ignore heavy vendors if re-added ---
R_data/VectorScaling/
R_data/**/node_modules/
R_data/**/bin/
R_data/**/models/
R_data/**/*.pt
R_data/**/*.onnx
R_data/**/*.bin
R_data/**/*.mp4
R_data/**/*.zip
R_data/**/*.7z
R_data/**/*.tar
R_data/**/*.gz

# Jupyter checkpoints
.ipynb_checkpoints/

# --- Phase A data collection (large / generated) ---
R_data/raw/
R_data/state/
R_data/corpus/
music_rec_artifacts/backup_*/

# --- Audio pipeline (collection stays external; derived data here) ---
# Keep the small CSVs (manifest, matches, new dataset lines); ignore caches/vectors.
R_data/audio/audio_lyrics.jsonl
R_data/audio/audio_embeddings.npy
R_data/audio/*.tmp

# --- Scalable serving caches (regenerable from the corpus) ---
music_rec_artifacts/lexical_cache.pkl
music_rec_artifacts/window_index.faiss
music_rec_artifacts/_parity_*.faiss
